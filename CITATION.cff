    given-names: Basant
    website: "https://basantbhattarai.com.np"
version: 0.2.0
date-released: "2026-10-16"
license: Apache-2.0
repository-code: "https://github.com/technobasant/evalproof"
url: "https://pypi.org/project/evalproof/"
keywords:
  - llm-evaluation
  - llm-as-a-judge
  - calibration
  - prediction-powered inference
  - mcnemar test
  - continuous integration
